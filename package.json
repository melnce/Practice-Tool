{
  "name": "practice-tool",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "imports": {},
  "main": "main.js",
  "scripts": {
    "test": "npm run check:boundaries && npm run build || exit 0 && vitest run -c vitest.config.ts",
    "test:watch": "npm run build || exit 0 && vitest -c vitest.config.ts",
    "test:all": "vitest run -c vitest.all.config.ts",
    "test:dev": "vitest run -c vitest.dev.config.ts --passWithNoTests",
    "check:boundaries": "npx tsx scripts/check-boundaries.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "watch:cards": "npx tsx scripts/watch_cards.ts",
    "replay:check": "npx tsx scripts/replay.ts",
    "replay:update": "npx tsx scripts/replay.ts --update"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.1",
    "ts-morph": "^27.0.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}