{
  "name": "practice-tool",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "imports": {},
  "main": "main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist .tsbuildinfo coverage .cache || exit 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check:boundaries": "npx tsx scripts/check-boundaries.ts && npx tsx scripts/check-triggers.ts",
    "check:arch": "npx tsx scripts/check-architecture.ts",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "test:all": "vitest run -c vitest.all.config.ts",
    "test:dev": "vitest run -c vitest.dev.config.ts --passWithNoTests",
    "test:golden": "vitest run tests/golden",
    "test:legacy": "vitest run --dir tests/legacy --passWithNoTests",
    "replay:check": "npx tsx scripts/replay.ts",
    "replay:update": "npx tsx scripts/replay.ts --update",
    "soak": "npx tsx scripts/soak.ts",
    "soak:smoke": "npx tsx scripts/soak.ts --smoke",
    "cards:update": "npx tsx scripts/mergeSets.ts",
    "cards:watch": "npx tsx scripts/watch_cards.ts",
    "ingest:cards": "npx tsx scripts/ingest-cards.ts",
    "ingest:tokens": "npx tsx scripts/ingest-tokens.ts",
    "check:cards": "npx tsx scripts/check-cards-sync.ts",
    "check:dangling-refs": "npx tsx scripts/check-dangling-refs.ts",
    "check:tokens": "npx tsx scripts/check-tokens-sync.ts",
    "check:card-text": "npx tsx scripts/check-card-text.ts",
    "check:add-to-hand": "npx tsx scripts/check-card-text.ts --gate=add-to-hand",
    "check:stat-op": "npx tsx scripts/check-card-text.ts --gate=stat-op",
    "check:destroy-op": "npx tsx scripts/check-card-text.ts --gate=destroy-op",
    "check:duration-op": "npx tsx scripts/check-card-text.ts --gate=duration-op",
    "check:op-keys": "npx tsx scripts/check-card-text.ts --gate=op-keys",
    "check:select-target": "npx tsx scripts/check-card-text.ts --gate=select-target",
    "check:enhance-replaces-fanfare": "npx tsx scripts/check-card-text.ts --gate=enhance-replaces-fanfare",
    "check:card-text-full": "npx tsx scripts/check-card-text.ts",
    "check:canonical-form": "npx tsx scripts/check-canonical-form.ts",
    "check:canonical-form:turn-scope": "npx tsx scripts/check-canonical-form.ts --gate=turn-scope --fail",
    "check:canonical-form:select-count": "npx tsx scripts/check-canonical-form.ts --gate=select-count --fail",
    "check:canonical-form:chosen-target": "npx tsx scripts/check-canonical-form.ts --gate=chosen-target --fail",
    "check:card-status": "npx tsx scripts/report-card-status.ts",
    "cards:baseline": "npx tsx scripts/card-behaviour.ts --record",
    "cards:verify": "npx tsx scripts/card-behaviour.ts --verify",
    "audit:superevolve-dedup": "npx tsx scripts/audit-super-evolve-dedup.ts",
    "test:audit": "vitest run -c vitest.audit.config.ts",
    "decks:discover": "npx tsx scripts/generate-deck-manifest.ts",
    "check:decks": "npm run decks:discover && npx tsx scripts/check-decks.ts",
    "predev": "npm run decks:discover",
    "prebuild": "npm run decks:discover",
    "check:fast": "npm run format:check && npm run lint && npm run typecheck && npm run test:dev",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run check:arch && npm run check:cards && npm run check:dangling-refs && npm run check:card-text-full && npm run check:add-to-hand && npm run check:stat-op && npm run check:destroy-op && npm run check:duration-op && npm run check:op-keys && npm run check:select-target && npm run check:enhance-replaces-fanfare && npm run check:canonical-form:turn-scope && npm run check:canonical-form:select-count && npm run check:canonical-form:chosen-target && npm run check:decks && npm run test:audit && npm run test && npm run replay:check",
    "check:deep": "npm run check && npm run test:all && npm run build && npm run test:listener-leak && npm run test:listener-leak:images-fail",
    "ci": "npm run check",
    "dev": "vite",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=e2e",
    "test:qa": "playwright test --project=qa",
    "test:listener-leak": "npx tsx scripts/listener-leak-harness.mjs",
    "test:listener-leak:images-fail": "LISTENER_LEAK_IMAGES=fail LISTENER_LEAK_PROBE=0 LISTENER_LEAK_SNAPSHOT=0 LISTENER_LEAK_CYCLES=20 LISTENER_LEAK_PORT=8886 npx tsx scripts/listener-leak-harness.mjs",
    "test:listener-leak:images-fulfil": "LISTENER_LEAK_IMAGES=fulfil LISTENER_LEAK_PROBE=0 LISTENER_LEAK_SNAPSHOT=0 LISTENER_LEAK_CYCLES=20 LISTENER_LEAK_PORT=8887 npx tsx scripts/listener-leak-harness.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-morph": "^27.0.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.15"
  }
}
