{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmitOnError": false,
        "rootDir": "./src",
        "outDir": "./dist",
        "allowJs": false,
        "checkJs": false,
        "strict": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2020"
        ],
        "baseUrl": ".",
        "paths": {
            "main": [
                "src/boot/boot.ts"
            ],
            "gameLogic": [
                "src/logic/index.ts"
            ],
            "@core/*": [
                "src/core/*"
            ],
            "@data/*": [
                "src/data/*"
            ],
            "@logic/*": [
                "src/helpers/*",
                "src/logic/*"
            ],
            "@ui/*": [
                "src/ui/*"
            ],
            "@helpers/*": [
                "src/helpers/*"
            ],
            "@ops/*": [
                "src/logic/effects/ops/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}